# Copy this file to .env and fill in the values for the one provider you're using.
# LLM_PROVIDER selects the backend; every script in this repo reads it through
# llm_provider.py, so no code changes are needed to switch providers.

LLM_PROVIDER=ollama

# Chat/completion model name. Required by every script that calls generate().
LLM_MODEL=gemma4:latest

# Embedding model name. Only required by 05-optimizers/optimizer_v3.py and
# 05-optimizers/test_embed.py. Anthropic has no embeddings API — use openai,
# azure, or ollama for those two files.
LLM_EMBEDDING_MODEL=

# ── openai ──────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# ── anthropic ───────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=

# ── azure openai ────────────────────────────────────────────────────────────
# LLM_PROVIDER=azure
# LLM_MODEL=<your chat deployment name>
# LLM_EMBEDDING_MODEL=<your embedding deployment name>
# AZURE_APIM_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_APIM_SUBSCRIPTION_KEY=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── ollama (local, no API key, $0 cost) ─────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:latest
# OLLAMA_HOST=http://localhost:11434
